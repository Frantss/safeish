{
  "name": "safeish",
  "version": "0.1.0",
  "private": false,
  "description": "Safe-ish error handling.",
  "keywords": [
    "error",
    "handling",
    "safe",
    "typescript"
  ],
  "bugs": {
    "url": "https://github.com/Frantss/safeish/issues"
  },
  "license": "MIT",
  "author": "Frantss <frantss.bongiovanni@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Frantss/safeish"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "typings": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "prepublishOnly": "pnpm build",
    "version": "changeset",
    "release": "changeset version && changeset publish",
    "test": "vp test",
    "test:dev": "vp test --watch",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.17.4",
    "@changesets/cli": "^2.29.2",
    "@types/bun": "latest",
    "ts-pattern": "^5.7.0",
    "typescript": "^5.8.3",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.5.1"
}
