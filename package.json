{
  "name": "safeish",
  "private": false,
  "version": "0.1.0",
  "description": "Safe-ish error handling.",
  "keywords": [
    "safe",
    "error",
    "handling",
    "typescript"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "typings": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "check-exports": "attw --pack . --profile node16",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "prepublishOnly": "pnpm build && pnpm check-exports",
    "version": "changeset",
    "release": "changeset version && changeset publish",
    "test": "vitest",
    "test:dev": "vitest --watch"
  },
  "bugs": {
    "url": "https://github.com/Frantss/safeish/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Frantss/safeish"
  },
  "author": "Frantss <frantss.bongiovanni@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@12.5.1",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.4",
    "@biomejs/biome": "1.9.4",
    "@changesets/cli": "^2.29.2",
    "@types/bun": "latest",
    "ts-pattern": "^5.7.0",
    "tsdown": "^0.9.9",
    "typescript": "^5.8.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.1.2"
  }
}
